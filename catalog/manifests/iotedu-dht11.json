{
  "id": "iotedu-dht11",
  "name": "DHT11 Driver",
  "description": "Single-wire DHT11 temperature and humidity driver. iotedu_dht11_register creates the Matter temperature and humidity endpoints. The desktop app does not display those readings. Native compilation from the desktop is still unavailable.",
  "type": "sensor",
  "version": "1.0.0",
  "status": "experimental",
  "source": "local",
  "target": "esp32h2",
  "idfCompatibility": ">=5.4.1 <5.5",
  "selectableForBuild": true,
  "firmware": {
    "idfComponentDir": "firmware/components/iotedu_dht11",
    "registerFunction": "iotedu_dht11_register",
    "requires": [],
    "kconfig": [
      {
        "key": "CONFIG_IOTEDU_DHT11_PIN",
        "pinName": "DHT11_DATA",
        "default": 4
      }
    ],
    "matter": {
      "endpoints": ["temperature_sensor", "humidity_sensor"],
      "clusters": ["TemperatureMeasurement", "RelativeHumidityMeasurement"]
    }
  }
}
